# Copy this file to .env and adjust the values.

# The local model. Pull it first: `ollama pull gemma4:31b`
AGENT_MODEL=gemma4:31b
OLLAMA_BASE_URL=http://localhost:11434

# Optional: send traces to LangSmith. Get a free API key at
# https://smith.langchain.com. Traces show prompts, tokens, and timings
# for every pipeline run, including evals.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=freightcase
